# Gemini AI API (Required for all AI features)
GEMINI_API_KEY="your_gemini_api_key"

# Stripe API (Required for payments and escrow)
STRIPE_SECRET_KEY="sk_test_..."
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=

# Google Maps API (Optional, for maps and address autocomplete)
VITE_GOOGLE_MAPS_API_KEY="your_google_maps_key"

# Firebase Configuration (Managed via firebase-applet-config.json)
# Ensure your Firebase project has Firestore, Auth, and Storage enabled.

# App Configuration
APP_URL="https://your-app-domain.com"
NODE_ENV="production"
JWT_SECRET="generate_a_random_string_here"
