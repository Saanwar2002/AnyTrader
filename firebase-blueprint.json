          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "url": { "type": "string", "format": "uri" }
            }
          }
        },
        "paymentPreference": { "type": "string", "enum": ["fixed_price", "hourly", "negotiable"] },
        "quoteScope": { "type": "string", "enum": ["labor_only", "complete_package"] },
        "hasReview": { "type": "boolean" },
        "hasTradespersonReview": { "type": "boolean" },
        "scheduledDate": { "type": "string", "format": "date" },
        "isConfirmedByTradesperson": { "type": "boolean" },
        "rescheduleProposal": {
          "type": "object",
          "properties": {
            "proposedDate": { "type": "string", "format": "date" },
            "reason": { "type": "string" },
            "proposedBy": { "type": "string" },
            "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
            "createdAt": { "type": "string", "format": "date-time" }
          }
        },
        "postedDate": { "type": "string", "format": "date-time" },
        "clientDeleted": { "type": "boolean", "description": "Soft delete flag for the homeowner" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "homeownerId", "category", "title", "description", "postcode", "status", "postedDate", "createdAt"]
    },
    "Quote": {
      "title": "Quote",
