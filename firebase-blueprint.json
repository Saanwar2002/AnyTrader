        "stripeFeeAmount": { "type": "number", "description": "Processing fee (higher for cards, capped for bank transfers)." },
        "platformCommission": { "type": "number", "description": "The AnyTrader platform cut based on the user's tier and any commission caps." },
        "paymentRail": { "type": "string", "enum": ["card", "bank_transfer"], "description": "The rail used (Bank used for jobs > £400)." },
