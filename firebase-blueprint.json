        "preferredDrivers": { "type": "array", "items": { "type": "string" }, "description": "UIDs of favorite drivers." },
        "emergencyContacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "phone": { "type": "string" }
            }
          }
        }
      },
      "required": ["uid", "role", "name"]
    },
    "DriverReview": {
      "title": "DriverReview",
      "description": "A review for a driver with a cooling-off period.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
