              "type": "object",
              "properties": {
                "maxQuotes": { "type": "integer" },
                "usedQuotes": { "type": "integer" }
              }
            }
          }
        },
        "notificationSettings": {
          "type": "object",
          "properties": {
            "quietHoursEnabled": { "type": "boolean" },
            "quietHoursStart": { "type": "string" },
            "quietHoursEnd": { "type": "string" },
            "pushEnabled": { "type": "boolean" },
            "emailEnabled": { "type": "boolean" }
          }
        },
