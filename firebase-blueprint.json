      },
      "required": ["id", "rideId", "driverId", "passengerId", "rating", "createdAt", "visibilityDate"]
    },
    "Job": {
      "title": "Job",
      "description": "A job posted by a homeowner.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "jobNo": { "type": "string", "description": "Human-readable job number (e.g., AT-123456)." },
        "homeownerId": { "type": "string" },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "postcode": { "type": "string" },
        "fullAddress": { "type": "string" },
        "houseNumber": { "type": "string" },
        "locationInstructions": { "type": "string" },
        "urgency": { "type": "string" },
        "status": { "type": "string", "enum": ["posted", "quoting", "accepted", "in_progress", "completed", "cancelled", "disputed"] },
        "dispute": {
          "type": "object",
          "properties": {
            "raisedBy": { "type": "string" },
            "reason": { "type": "string" },
            "isPropertyDamage": { "type": "boolean", "description": "Whether the dispute involves physical damage to property." },
            "isHandshakeVerified": { "type": "boolean", "description": "True if the job was completed via QR handshake, restricting frivolous claims." },
            "mediationStakePaid": { "type": "boolean", "description": "Whether the £15 friction fee has been paid for this mediation." },
            "technicalFaultReport": { "type": "string", "description": "Mandatory technical explanation for non-cosmetic disputes." },
            "pliClaim": {
              "type": "object",
              "properties": {
                "status": { "type": "string", "enum": ["none", "requested", "initiated", "rejected", "settled"] },
                "provider": { "type": "string" },
                "policyNumber": { "type": "string" },
                "initiatedAt": { "type": "string", "format": "date-time" }
              }
            },
            "photos": { "type": "array", "items": { "type": "string" } },
            "status": { "type": "string", "enum": ["open", "resolved", "mediated"] },
            "createdAt": { "type": "string", "format": "date-time" }
          }
        },
        "estimateMin": { "type": "number" },
        "estimateMax": { "type": "number" },
