              "createdAt": { "type": "string", "format": "date-time" }
            },
            "required": ["id", "name"]
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "deviceId": { "type": "string" },
        "ipAddress": { "type": "string" },
        "favoriteAddresses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "address": { "type": "string" }
            }
          }
        },
        "regularJourneys": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "from": { "type": "string" },
              "to": { "type": "string" },
              "comments": { "type": "string" }
            }
          }
        },
