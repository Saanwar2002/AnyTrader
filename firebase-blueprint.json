              "timestamp": { "type": "string", "format": "date-time" },
              "reason": { "type": "string" }
            }
          }
        },
        "revisionCount": { "type": "integer" },
        "paymentTrack": { "type": "string", "enum": ["quick", "project"] },
        "guaranteeExpiresAt": { "type": "string", "format": "date-time" },
