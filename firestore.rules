rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == "saanwar2002@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ecosystem_manager'))
      );
    }

    function isEcosystemManager() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == "saanwar2002@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ecosystem_manager'))
      );
    }

    function isValidJob(data) {
      return data.keys().hasAll(['id', 'homeownerId', 'category', 'title', 'description', 'postcode', 'status', 'postedDate', 'createdAt', 'paymentPreference', 'quoteScope', 'urgency']) &&
             data.id is string &&
             data.homeownerId is string &&
             data.category is string &&
             data.title is string && data.title.size() >= 3 && data.title.size() <= 100 &&
             data.description is string && data.description.size() <= 5000 &&
             data.postcode is string &&
             data.status in ["posted", "quoting", "accepted", "in_progress", "completed", "cancelled", "disputed"] &&
             data.paymentPreference in ["fixed_price", "hourly", "negotiable"] &&
             data.quoteScope in ["labor_only", "complete_package"] &&
             data.urgency in ["flexible", "asap", "emergency", "specific_date", "within_week"] &&
             data.postedDate is timestamp &&
             data.createdAt is timestamp &&
             (!('quoteCount' in data) || data.quoteCount is int) &&
             (!('recurringDismissedBy' in data) || data.recurringDismissedBy is list) &&
             (!('isRecurringInstance' in data) || data.isRecurringInstance is bool) &&
             (!('recurringScheduleId' in data) || data.recurringScheduleId is string) &&
             (!('expiryAcknowledged' in data) || data.expiryAcknowledged is bool) &&
             (!('hasReview' in data) || data.hasReview is bool) &&
             (!('photos' in data) || data.photos is list) &&
             (!('city' in data) || data.city is string) &&
             (!('area' in data) || data.area is string) &&
             (!('county' in data) || data.county is string);
    }

    function isJobImmutableUnchanged() {
      return request.resource.data.id == resource.data.id &&
             request.resource.data.homeownerId == resource.data.homeownerId;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['id', 'jobId', 'reviewerId', 'revieweeId', 'rating', 'comment', 'createdAt']) &&
             data.keys().hasOnly(['id', 'jobId', 'reviewerId', 'revieweeId', 'rating', 'comment', 'createdAt']) &&
             data.id is string &&
             data.jobId is string &&
             data.reviewerId is string &&
             data.revieweeId is string &&
             data.rating is int && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() <= 1000 &&
             data.createdAt is timestamp;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['role', 'name', 'phone']) &&
             data.role in ['homeowner', 'tradesperson', 'business', 'admin', 'ecosystem_manager'] &&
             (!('email' in data) || data.email is string) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.phone is string;
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth.uid == userId;
      allow update: if isAuthenticated() && ((request.auth.uid == userId && isValidUser(request.resource.data)) || isAdmin());
      allow delete: if isAuthenticated() && (request.auth.uid == userId || request.auth.token.email.lower() == "saanwar2002@gmail.com" || isAdmin());
    }

    match /jobs/{jobId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidJob(request.resource.data) && (
        request.resource.data.homeownerId == request.auth.uid || 
        (request.resource.data.isRecurringInstance == true && 
         get(/databases/$(database)/documents/recurring_schedules/$(request.resource.data.recurringScheduleId)).data.tradespersonId == request.auth.uid)
      );
      allow update: if isAuthenticated() && (
        (isValidJob(request.resource.data) && resource.data.homeownerId == request.auth.uid && isJobImmutableUnchanged()) || 
        (isValidJob(request.resource.data) && isJobImmutableUnchanged() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quoteCount']) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'tradesperson') ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.homeownerId == request.auth.uid || isAdmin());

      // Allow writes to subcollections
      match /quotes/{quoteId} {
        allow read: if isAuthenticated() && (
          (get(/databases/$(database)/documents/jobs/$(jobId)).data.homeownerId == request.auth.uid) || 
          (resource.data.tradespersonId == request.auth.uid) || 
          isAdmin()
        );
        allow create: if isAuthenticated();
        allow update: if isAuthenticated() && (
          resource.data.tradespersonId == request.auth.uid || 
          get(/databases/$(database)/documents/jobs/$(jobId)).data.homeownerId == request.auth.uid ||
          isAdmin()
        );
        allow delete: if isAuthenticated() && (
          resource.data.tradespersonId == request.auth.uid || 
          isAdmin()
        );
      }
    }

    match /{path=**}/jobs/{jobId} {
      allow read: if isAuthenticated();
    }

    match /{path=**}/quotes/{quoteId} {
      allow read: if isAuthenticated() && (
        (resource.data.homeownerId == request.auth.uid) || 
        (resource.data.tradespersonId == request.auth.uid) || 
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.tradespersonId == request.auth.uid || 
        (path.size() >= 2 && path[0] == 'jobs' && get(/databases/$(database)/documents/jobs/$(path[1])).data.homeownerId == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.tradespersonId == request.auth.uid || 
        isAdmin()
      );
    }

    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.participants || isAdmin());
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.participants || isAdmin());
      allow delete: if isAdmin();
      
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants || isAdmin());
        allow create: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants || isAdmin());
        allow delete: if isAdmin();
      }
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
        isValidReview(request.resource.data) &&
        request.resource.data.reviewerId == request.auth.uid &&
        get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.status == 'completed' &&
        get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.homeownerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }

    match /invitations/{invitationId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.token.email == resource.data.email);
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /broadcasts/{broadcastId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    match /recurring_schedules/{scheduleId} {
      allow read: if isAuthenticated() && (
        ('participants' in resource.data && request.auth.uid in resource.data.participants) || 
        resource.data.homeownerId == request.auth.uid || 
        resource.data.tradespersonId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        ('participants' in request.resource.data && request.auth.uid in request.resource.data.participants) ||
        request.resource.data.homeownerId == request.auth.uid || 
        request.resource.data.tradespersonId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        ('participants' in resource.data && request.auth.uid in resource.data.participants) || 
        resource.data.homeownerId == request.auth.uid || 
        resource.data.tradespersonId == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /platform_config/{configId} {
      allow read: if configId != 'secrets' || isAdmin();
      allow write: if isAdmin();
    }

    match /platform_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /trader_notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /search_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /security_alerts/{alertId} {
      allow read: if isAuthenticated();
      allow update, delete: if isAdmin();
      allow create: if isAuthenticated();
    }

    match /shop_orders/{orderId} {
      allow read, create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isAdmin();
    }

    match /partners/{partnerId} {
      allow read: if isAuthenticated();
      allow write: if isEcosystemManager();
    }

    match /campaigns/{campaignId} {
      allow read: if isAuthenticated();
      allow write: if isEcosystemManager();
    }

    match /leads/{leadId} {
      allow read: if isEcosystemManager() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isEcosystemManager();
      allow delete: if isAdmin();
    }
  }
}
