rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Global Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { 
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'saanwar2002@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      ); 
    }
    
    // --- Default Deny ---
    match /{document=**} {
      allow read, write: if false;
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /test/connection {
      allow read: if true;
    }

    // Collection group rule for quotes
    match /{path=**}/quotes/{quoteId} {
      allow read, list: if isSignedIn() && (
        resource.data.tradespersonId == request.auth.uid || 
        resource.data.homeownerId == request.auth.uid || 
        isAdmin()
      );
    }

    // --- Platform Config (Readable by all for init) ---
    match /platform_config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /platform_categories/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /dynamic_search_synonyms/{synonymId} {
      allow read: if true;
      allow write: if isAdmin() || (isSignedIn() && (request.resource.data.get('addedBy', '') == request.auth.uid || resource.data.get('addedBy', '') == request.auth.uid));
    }
    match /unmatched_search_telemetry/{telemetryId} {
      allow read: if isSignedIn() || isAdmin();
      allow create, update: if request.resource.data.query is string && request.resource.data.query.size() <= 200;
      allow delete: if isAdmin();
    }

    // --- User Profiles (Public/Private Split) ---
    match /advertisements/{adId} {
      allow read: if true;
      allow write: if isSignedIn() && (
        resource == null || 
        resource.data.advertiserUid == request.auth.uid || 
        request.resource.data.advertiserUid == request.auth.uid || 
        isAdmin() || 
        adId.matches('^ad-.*$') || 
        adId.matches('^seed-.*$') || 
        request.resource.data.advertiserUid.matches('^seed-.*$')
      );
    }

    match /users/{userId} {
      allow read: if true; // Public read for profile discovery, both search list & get profile
      allow create: if (isOwner(userId) && (
        isAdmin() || (
          request.resource.data.get('isAdmin', false) == false && 
          !(request.resource.data.get('role', '') in ['admin', 'ecosystem_manager'])
        )
      )) || (isSignedIn() && (isAdmin() || userId.matches('^mock-trader-.*$') || userId.matches('^seed-.*$') || userId.matches('^sample_.*$')));
      allow delete: if isOwner(userId) || (isSignedIn() && (isAdmin() || userId.matches('^mock-trader-.*$') || userId.matches('^seed-.*$') || userId.matches('^sample_.*$')));
      
      // Prevent privilege escalation and paid subscription tampering while allowing profile management & seeding
      allow update: if (
        isSignedIn() && (
          (isOwner(userId) && (
            isAdmin() || (
              request.resource.data.get('isAdmin', false) == false && 
              !(request.resource.data.get('role', '') in ['admin', 'ecosystem_manager']) &&
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscriptionStatus', 'subscriptionId', 'hasExclusiveAddon', 'tierId', 'pendingPlatformFees', 'stripeCustomerId', 'gothamSubscription'])
            )
          )) || 
          isAdmin() ||
          userId.matches('^mock-trader-.*$') || 
          userId.matches('^seed-.*$') || 
          userId.matches('^sample_.*$')
        )
      ) || userId.matches('^mock-trader-.*$') || userId.matches('^seed-.*$') || userId.matches('^sample_.*$');
    }

    // --- Rides Portal ---
    match /driver_reviews/{reviewId} {
      allow create: if isSignedIn() && (request.resource.data.get('passengerId', '') == request.auth.uid || request.resource.data.get('riderId', '') == request.auth.uid);
      // Passengers cannot read them afterwards.
      // Drivers can only list reviews that have passed the cooling-off period.
      allow read, list: if isAdmin() || (
        isSignedIn() && 
        (resource == null || (resource.data.driverId == request.auth.uid && resource.data.visibilityDate <= request.time))
      );
      allow update: if false; // immutable by users
    }

    match /ride_requests/{rideId} {
      allow create: if isSignedIn() && (request.resource.data.get('passengerId', '') == request.auth.uid || request.resource.data.get('riderId', '') == request.auth.uid);
      allow read: if isSignedIn() && (resource == null || resource.data.status in ["pending", "searching", "offered", "draft"] || resource.data.get('passengerId', '') == request.auth.uid || resource.data.get('riderId', '') == request.auth.uid || resource.data.get('driverId', '') == request.auth.uid || resource.data.get('assignedDriverId', '') == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource == null || resource.data.get('passengerId', '') == request.auth.uid || resource.data.get('riderId', '') == request.auth.uid || resource.data.get('driverId', '') == request.auth.uid || resource.data.get('assignedDriverId', '') == request.auth.uid || isAdmin());
      allow delete: if isAdmin();

      match /chat/{messageId} {
        allow read, write: if isSignedIn() && (get(/databases/$(database)/documents/ride_requests/$(rideId)).data.get('passengerId', '') == request.auth.uid || get(/databases/$(database)/documents/ride_requests/$(rideId)).data.get('riderId', '') == request.auth.uid || get(/databases/$(database)/documents/ride_requests/$(rideId)).data.get('driverId', '') == request.auth.uid || get(/databases/$(database)/documents/ride_requests/$(rideId)).data.get('assignedDriverId', '') == request.auth.uid || isAdmin());
      }
    }

    match /reported_hazards/{hazardId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource == null || resource.data.reporterId == request.auth.uid || isAdmin());
    }
    
    match /live_tracking/{rideId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (resource == null || resource.data.driverId == request.auth.uid || request.resource.data.driverId == request.auth.uid || isAdmin());
    }

    match /driver_status/{driverId} {
      allow read: if isSignedIn();
      allow write: if isOwner(driverId);
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
    }

    match /sms_queue/{queueId} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }

    match /email_queue/{queueId} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow read, list: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.participants || isAdmin());
      allow update: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants || isAdmin());
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && (get(/databases/$(database)/documents/conversations/$(conversationId)) == null || request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants || isAdmin());
        allow create: if isSignedIn() && (request.auth.uid == request.resource.data.senderId || isAdmin());
      }
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.resource.data.reviewerId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    match /driver_metrics/{driverId} {
      allow read, list: if isSignedIn() && (driverId == request.auth.uid || isAdmin());
      allow write: if isOwner(driverId) || isAdmin();
    }

    match /driver_expenses/{expenseId} {
      allow read, list: if isSignedIn() && (resource == null || resource.data.driverId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.driverId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource == null || resource.data.driverId == request.auth.uid || isAdmin());
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
    }

    match /invitations/{invitationId} {
      allow get, list: if isSignedIn() && (
        isAdmin() || 
        resource == null || 
        (request.auth.token.email != null && resource.data.get('email', '').lower() == request.auth.token.email.lower()) ||
        resource.data.get('invitedBy', '') == request.auth.uid
      );
      allow create: if isSignedIn() && (
        isAdmin() || 
        request.resource.data.get('invitedBy', '') == request.auth.uid
      );
      allow update: if isSignedIn() && (
        isAdmin() || 
        resource.data.get('invitedBy', '') == request.auth.uid ||
        (request.auth.token.email != null && resource.data.get('email', '').lower() == request.auth.token.email.lower())
      );
      allow delete: if isSignedIn() && (
        isAdmin() || 
        resource.data.get('invitedBy', '') == request.auth.uid
      );
    }

    match /emergency_broadcasts/{broadcastId} {
      allow read: if isAdmin() || isSignedIn();
      allow create: if isSignedIn();
      allow write: if isAdmin();
    }

    match /broadcasts/{broadcastId} {
      allow read: if isSignedIn() || isAdmin();
      allow write: if isAdmin();
    }

    match /search_logs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /platform_counters/{counterId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /promo_codes/{promoId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /partners/{partnerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /campaigns/{campaignId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /leads/{leadId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
    }
    match /security_alerts/{alertId} {
      allow read: if isAdmin() || isSignedIn();
      allow write: if isAdmin() || isSignedIn();
    }
    match /admin_alert_rules/{ruleId} {
      allow read: if isAdmin() || isSignedIn();
      allow write: if isAdmin();
    }
    match /email_alerts_queue/{queueId} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }
    match /shop_orders/{orderId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isAdmin();
    }
    match /assets/{assetId} {
      allow read: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (request.resource.data.ownerId == request.auth.uid || isAdmin());
    }
    match /scheduledRepairs/{taskId} {
      allow get, list: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
    }

    match /properties/{propertyId} {
      allow get: if true;
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.ownerId == request.auth.uid || request.resource.data.userId == request.auth.uid);
      allow update: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        isAdmin() ||
        resource.data.get('transferStatus', '') == 'pending'
      );
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || resource.data.userId == request.auth.uid || isAdmin());
    }

    match /tenant_issues/{issueId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isSignedIn();
    }

    match /field_agents/{agentId} {
      allow get: if isSignedIn() && (resource.data.businessId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.businessId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.businessId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.businessId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.businessId == request.auth.uid || isAdmin());
    }

    match /dispatch_routes/{routeId} {
      allow get: if isSignedIn() && (resource.data.businessId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.businessId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.businessId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.businessId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.businessId == request.auth.uid || isAdmin());
    }

    match /dispatches/{dispatchId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /recurring_schedules/{scheduleId} {
      allow read: if isSignedIn() && (resource == null || resource.data.homeownerId == request.auth.uid || resource.data.tradespersonId == request.auth.uid || isAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (request.resource.data.homeownerId == request.auth.uid || request.resource.data.tradespersonId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource == null || resource.data.homeownerId == request.auth.uid || resource.data.tradespersonId == request.auth.uid || isAdmin());
    }

    // --- Instant Match and Scores ---
    match /instant_matches/{matchId} {
      allow get: if isSignedIn() && (resource.data.get('customerId', '') == request.auth.uid || resource.data.get('matchedTraderId', '') == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.matchedTraderId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.get('customerId', '') == request.auth.uid || isAdmin());
      allow update: if isSignedIn(); // Allow traders to respond to attempts, update match status
    }

    match /instant_match_attempts/{attemptId} {
      allow get: if isSignedIn() && (resource.data.get('traderId', '') == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.traderId == request.auth.uid || isAdmin());
      allow create: if isAdmin() || (isSignedIn() && (request.auth.uid == get(/databases/$(database)/documents/instant_matches/$(request.resource.data.instantMatchId)).data.customerId || request.auth.uid == getAfter(/databases/$(database)/documents/instant_matches/$(request.resource.data.instantMatchId)).data.customerId));
      allow update: if isSignedIn() && (resource.data.get('traderId', '') == request.auth.uid || isAdmin());
    }

    match /users/{userId}/trader_match_scores/{categoryId} {
      allow read: if isSignedIn() && (userId == request.auth.uid || isAdmin());
      allow write: if isAdmin() || (isSignedIn() && userId == request.auth.uid);
    }

    // --- Home Portal (Tradesperson/Homeowner Logic) ---
    match /jobs/{jobId} {
      allow read, list: if true; // Public read so guest visitors & registered users can view posted jobs, feed & property passports
      allow create: if isSignedIn() && (
        request.resource.data.get('homeownerId', '') == request.auth.uid || 
        request.resource.data.get('userId', '') == request.auth.uid || 
        request.resource.data.get('ownerId', '') == request.auth.uid || 
        request.resource.data.get('posterId', '') == request.auth.uid || 
        request.resource.data.get('customerId', '') == request.auth.uid || 
        request.resource.data.get('isRecurringInstance', false) == true || 
        isAdmin() ||
        request.resource.data.get('homeownerId', '').matches('^seed-.*$') ||
        request.resource.data.get('homeownerId', '').matches('^sample_.*$') ||
        request.resource.data.get('homeownerId', '').matches('^mock-.*$')
      );
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (
        resource == null || 
        resource.data.get('homeownerId', '') == request.auth.uid || 
        resource.data.get('userId', '') == request.auth.uid || 
        resource.data.get('ownerId', '') == request.auth.uid || 
        isAdmin() ||
        resource.data.get('homeownerId', '').matches('^seed-.*$') ||
        resource.data.get('homeownerId', '').matches('^sample_.*$') ||
        resource.data.get('homeownerId', '').matches('^mock-.*$')
      );
    }

    match /jobs/{jobId}/quotes/{quoteId} {
      allow read, list: if true;
      allow create: if isSignedIn() && (
        request.resource.data.get('tradespersonId', '') == request.auth.uid || 
        request.resource.data.get('proId', '') == request.auth.uid || 
        request.resource.data.get('homeownerId', '') == request.auth.uid || 
        request.resource.data.get('userId', '') == request.auth.uid || 
        isAdmin()
      );
      allow update: if isSignedIn() && (
        resource == null || 
        resource.data.get('tradespersonId', '') == request.auth.uid || 
        resource.data.get('proId', '') == request.auth.uid || 
        resource.data.get('homeownerId', '') == request.auth.uid || 
        resource.data.get('userId', '') == request.auth.uid || 
        isAdmin()
      );
    }

    // --- Consultancy System ---
    match /rateCards/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.resource.data.consultantId == request.auth.uid || isAdmin());
    }
    match /availabilityWindows/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.resource.data.consultantId == request.auth.uid || isAdmin());
    }
    match /calendarSyncs/{id} {
      allow read: if isSignedIn() && (resource == null || resource.data.consultantId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (request.resource.data.consultantId == request.auth.uid || isAdmin());
    }
    // Helper function for consultancy and trade ownership
    function isConsultancyOwner() {
      return isSignedIn() && (
        (resource != null && (
          resource.data.get('businessId', '') == request.auth.uid || 
          resource.data.get('consultantId', '') == request.auth.uid || 
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('traderId', '') == request.auth.uid ||
          resource.data.get('creatorId', '') == request.auth.uid
        )) ||
        (request.resource != null && (
          request.resource.data.get('businessId', '') == request.auth.uid || 
          request.resource.data.get('consultantId', '') == request.auth.uid || 
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('traderId', '') == request.auth.uid ||
          request.resource.data.get('creatorId', '') == request.auth.uid
        )) ||
        isAdmin()
      );
    }

    match /projectRoles/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (resource == null || isConsultancyOwner());
    }
    match /projectBids/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (resource == null || isConsultancyOwner() || request.resource.data.bidderId == request.auth.uid);
    }
    match /projectShortlists/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (resource == null || isConsultancyOwner());
    }
    match /projects/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (resource == null || isConsultancyOwner() || resource.data.clientId == request.auth.uid);
    }
    match /clients/{id} {
      allow read: if isSignedIn() && (resource == null || isConsultancyOwner());
      allow write: if isSignedIn() && (resource == null || isConsultancyOwner());
    }
    match /proposals/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (resource == null || isConsultancyOwner());
    }
    match /proposalTemplates/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (resource == null || isConsultancyOwner());
    }
    match /projectMilestones/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (resource == null || isConsultancyOwner());
    }
    match /teamMembers/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (resource == null || isConsultancyOwner());
    }
    match /projectAssignments/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (resource == null || isConsultancyOwner());
    }
    match /projectVenues/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (resource == null || isConsultancyOwner());
    }
    match /venues/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /projectSuppliers/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (resource == null || isConsultancyOwner());
    }
    match /supplierContacts/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (resource == null || isConsultancyOwner());
    }
    match /projectTimelineItems/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (resource == null || isConsultancyOwner());
    }
    match /invoices/{id} {
      allow read: if isSignedIn() && (
        resource == null || 
        isConsultancyOwner() || 
        resource.data.get('traderId', '') == request.auth.uid || 
        resource.data.get('consultantId', '') == request.auth.uid || 
        resource.data.get('userId', '') == request.auth.uid || 
        resource.data.get('businessId', '') == request.auth.uid || 
        resource.data.get('clientId', '') == request.auth.uid || 
        resource.data.get('homeownerId', '') == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.get('traderId', '') == request.auth.uid || 
        request.resource.data.get('consultantId', '') == request.auth.uid || 
        request.resource.data.get('userId', '') == request.auth.uid || 
        request.resource.data.get('businessId', '') == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isSignedIn() && (
        resource == null || 
        isConsultancyOwner() || 
        resource.data.get('traderId', '') == request.auth.uid || 
        resource.data.get('consultantId', '') == request.auth.uid || 
        resource.data.get('userId', '') == request.auth.uid || 
        resource.data.get('businessId', '') == request.auth.uid ||
        isAdmin()
      );
    }
    match /expenses/{id} {
      allow read: if isSignedIn() && (
        resource == null || 
        isConsultancyOwner() || 
        resource.data.get('consultantId', '') == request.auth.uid || 
        resource.data.get('traderId', '') == request.auth.uid || 
        resource.data.get('userId', '') == request.auth.uid ||
        isAdmin()
      );
      allow write: if isSignedIn() && (
        resource == null || 
        isConsultancyOwner() || 
        request.resource.data.get('consultantId', '') == request.auth.uid || 
        request.resource.data.get('traderId', '') == request.auth.uid || 
        request.resource.data.get('userId', '') == request.auth.uid ||
        isAdmin()
      );
    }
    match /portfolioItems/{id} {
      allow read: if true;
      allow write: if isSignedIn() && (request.resource.data.consultantId == request.auth.uid || isAdmin());
    }
    match /sessionNotes/{id} {
      allow read: if isSignedIn() && (resource == null || isConsultancyOwner());
      allow write: if isSignedIn() && (resource == null || isConsultancyOwner());
    }
    match /calendarEvents/{id} {
      allow read: if isSignedIn() && (resource == null || isConsultancyOwner());
      allow write: if isSignedIn() && (resource == null || isConsultancyOwner());
    }
    match /matchScores/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (resource == null || isConsultancyOwner());
    }
    match /enquiries/{id} {
      allow read: if isSignedIn() && (resource == null || isConsultancyOwner() || resource.data.senderId == request.auth.uid);
      allow write: if isSignedIn();
    }
    match /support_tickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isSignedIn();
    }
    match /bidding_jobs/{jobId} {
      allow read, list: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /affiliates/{affiliateId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /appointments/{appointmentId} {
      allow get: if isSignedIn() && (resource.data.get('customerId', '') == request.auth.uid || resource.data.get('traderId', '') == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.traderId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.get('customerId', '') == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.get('customerId', '') == request.auth.uid || resource.data.get('traderId', '') == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /flash_deals/{dealId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.traderId == request.auth.uid || 
        request.resource.data.traderId.matches('^seed-.*$') || 
        request.resource.data.traderId.matches('^mock-trader-.*$') || 
        request.resource.data.traderId.matches('^sample_.*$') || 
        dealId.matches('^deal-.*$') || 
        dealId.matches('^seed-.*$') || 
        isAdmin()
      );
      allow update: if isSignedIn() && (
        resource.data.traderId == request.auth.uid || 
        resource.data.traderId.matches('^seed-.*$') || 
        resource.data.traderId.matches('^mock-trader-.*$') || 
        dealId.matches('^deal-.*$') || 
        dealId.matches('^seed-.*$') || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedCount', 'status', 'updatedAt']) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.traderId == request.auth.uid || 
        resource.data.traderId.matches('^seed-.*$') || 
        resource.data.traderId.matches('^mock-trader-.*$') || 
        dealId.matches('^deal-.*$') || 
        dealId.matches('^seed-.*$') || 
        isAdmin()
      );
    }

    match /system_settings/{settingId} {
      allow read, write: if isAdmin();
    }

    match /admin_login_audits/{auditId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // --- AI Agent Ecosystem & Audit Log Collections ---
    match /platform_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || (isSignedIn() && settingId == 'ai_agent_ecosystem');
    }

    match /ai_agent_audit_logs/{logId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /materials_arbitrage_alerts/{alertId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /demand_surge_forecasts/{forecastId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
