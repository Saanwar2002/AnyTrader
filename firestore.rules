rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Global Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email != null && request.auth.token.email.lower() == "saanwar2002@gmail.com" && request.auth.token.email_verified == true)
      ); 
    }
    
    // --- Default Deny ---
    match /{document=**} {
      allow read, write: if false;
    }

    match /test/connection {
      allow read: if true;
    }

    // Collection group rule for quotes
    match /{path=**}/quotes/{quoteId} {
      allow read, list: if isSignedIn() && (
        resource == null || 
        resource.data.tradespersonId == request.auth.uid || 
        resource.data.homeownerId == request.auth.uid || 
        isAdmin()
      );
    }

    // --- Platform Config (Readable by all for init) ---
    match /platform_config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /platform_categories/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- User Profiles (Public/Private Split) ---
    match /users/{userId} {
      allow read: if true; // Public read for profile discovery, both search list & get profile
      allow create: if isOwner(userId) || isAdmin() || userId.matches('^mock-trader-.*$');
      allow delete: if isOwner(userId) || isAdmin() || userId.matches('^mock-trader-.*$');
      
      // Prevent privilege escalation
      allow update: if (
        isSignedIn() && (
          (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'bio', 'avatarUrl', 'notificationSettings', 'favoriteAddresses', 'regularJourneys', 'emergencyContacts', 'pendingCharges', 'cancellationCount'
          ])) || isAdmin()
        )
      ) || userId.matches('^mock-trader-.*$');
    }

    // --- Rides Portal ---
    match /ride_requests/{rideId} {
      allow get: if isSignedIn() && (resource.data.get('riderId', '') == request.auth.uid || resource.data.get('driverId', '') == request.auth.uid || resource.data.get('assignedDriverId', '') == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.riderId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.get('riderId', '') == request.auth.uid || 
        resource.data.get('driverId', '') == request.auth.uid || 
        request.resource.data.get('driverId', '') == request.auth.uid || 
        request.resource.data.get('assignedDriverId', '') == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.get('riderId', '') == request.auth.uid || isAdmin());
      allow list: if isSignedIn();

      match /chat/{messageId} {
        allow read, list: if isSignedIn(); 
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      }
    }
    
    match /live_tracking/{rideId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
    }

    match /driver_status/{driverId} {
      allow read: if isSignedIn();
      allow write: if isOwner(driverId);
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isAdmin() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
    }

    match /conversations/{conversationId} {
      allow read, list: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.participants || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants || isAdmin());
        allow create: if isSignedIn() && (request.auth.uid == request.resource.data.senderId || isAdmin());
      }
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.resource.data.reviewerId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    match /driver_metrics/{driverId} {
      allow read, list: if isSignedIn() && (driverId == request.auth.uid || isAdmin());
      allow write: if isOwner(driverId) || isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
    }

    match /invitations/{invitationId} {
      allow get: if isAdmin() || (isSignedIn() && request.auth.token.email != null && resource.data.email == request.auth.token.email.lower());
      allow list: if isAdmin() || (isSignedIn() && request.auth.token.email != null && resource.data.email == request.auth.token.email.lower());
      allow write: if isAdmin();
    }

    match /broadcasts/{broadcastId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /search_logs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /platform_counters/{counterId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /partners/{partnerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /campaigns/{campaignId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /leads/{leadId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
    }
    match /security_alerts/{alertId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /shop_orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isAdmin();
    }
    match /assets/{assetId} {
      allow read: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (request.resource.data.ownerId == request.auth.uid || isAdmin());
    }
    match /dispatches/{dispatchId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /recurring_schedules/{scheduleId} {
      allow read: if isSignedIn() && (resource.data.homeownerId == request.auth.uid || resource.data.tradespersonId == request.auth.uid || isAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (request.resource.data.homeownerId == request.auth.uid || request.resource.data.tradespersonId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.homeownerId == request.auth.uid || resource.data.tradespersonId == request.auth.uid || isAdmin());
    }

    // --- Home Portal (Tradesperson/Homeowner Logic) ---
    match /jobs/{jobId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.resource.data.homeownerId == request.auth.uid || request.resource.data.isRecurringInstance == true || isAdmin());
      allow update: if isSignedIn() && (resource.data.homeownerId == request.auth.uid || isAdmin());
    }

    match /jobs/{jobId}/quotes/{quoteId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() && (request.resource.data.tradespersonId == request.auth.uid || request.resource.data.homeownerId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.tradespersonId == request.auth.uid || resource.data.homeownerId == request.auth.uid || isAdmin());
    }
  }
}
